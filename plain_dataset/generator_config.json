{
  "seed": 42,
  "tokenizer": "sentence-transformers/all-MiniLM-L6-v2",
  "n_intents": 21,
  "n_phrasings_per_intent": 3,
  "n_benign_pool": 210,
  "version": "2.0",
  "uniqueness_rule": "global (across all intents)",
  "matching_rule": "10*token_delta + char_delta",
  "derivation_source": "phrasings.json"
}